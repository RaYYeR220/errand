# Copy to .env with scripts/init-env.sh, which fills every empty secret below
# with a random value. .env is git-ignored.

# --- Hostnames -----------------------------------------------------------------
# Suppliers are served at northwind.<BASE_DOMAIN>, api.northwind.<BASE_DOMAIN>
# and acme.<BASE_DOMAIN>. On a VM use <public-ip>.sslip.io; locally localtest.me
# (resolves to 127.0.0.1).
BASE_DOMAIN=localtest.me
PUBLIC_SCHEME=https
# Caddy global options. "local_certs" issues certificates from Caddy's local CA
# (browsers need ignoreHTTPSErrors or the CA installed); on a public VM use
# "email you@example.com" to get Let's Encrypt certificates.
CADDY_GLOBAL_OPTIONS=local_certs
# Profiles to start; "edge" runs the bundled Caddy on HTTP_PORT/HTTPS_PORT.
# Leave empty when another reverse proxy on the host fronts the services.
COMPOSE_PROFILES=edge
HTTP_PORT=80
HTTPS_PORT=443

# Loopback ports for an external reverse proxy (bound to 127.0.0.1 only).
NORTHWIND_STOREFRONT_PORT=8100
NORTHWIND_API_PORT=9100
ACME_PORT=8200

# --- Northwind Supply (Medusa) -----------------------------------------------------
NORTHWIND_DB_PASSWORD=
NORTHWIND_JWT_SECRET=
NORTHWIND_COOKIE_SECRET=
# Storefront publishable API key; the seed assigns this token to the key.
NORTHWIND_PUBLISHABLE_KEY=
NORTHWIND_ADMIN_EMAIL=admin@northwind-supply.example
NORTHWIND_ADMIN_PASSWORD=
# Lumen Labs buyer account (storefront sign-in).
NORTHWIND_BUYER_EMAIL=buyer@lumenlabs.example
NORTHWIND_BUYER_PASSWORD=
# More buyers on the same company team (buyer2@…, buyer3@…), so errands can run side by side.
NORTHWIND_BUYER2_PASSWORD=
NORTHWIND_BUYER3_PASSWORD=

# --- Acme Office & Tech (WooCommerce) ----------------------------------------------
ACME_DB_PASSWORD=
ACME_DB_ROOT_PASSWORD=
# Seed for the WordPress auth keys and salts.
ACME_WP_SECRET=
ACME_ADMIN_USER=acme-admin
ACME_ADMIN_EMAIL=admin@acme-office.example
ACME_ADMIN_PASSWORD=
# Lumen Labs buyer account (sign in with username or email).
ACME_BUYER_USERNAME=lumenlabs-buyer
ACME_BUYER_EMAIL=buyer@lumenlabs.example
ACME_BUYER_PASSWORD=
# More buyers on the same company team (lumenlabs-buyer2, lumenlabs-buyer3).
ACME_BUYER2_PASSWORD=
ACME_BUYER3_PASSWORD=
