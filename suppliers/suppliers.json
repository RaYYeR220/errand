{
  "suppliers": [
    {
      "id": "northwind",
      "name": "Northwind Supply",
      "platform": "medusa-v2-b2b-starter",
      "base_url": "https://northwind.{BASE_DOMAIN}",
      "login_url": "https://northwind.{BASE_DOMAIN}/us/account",
      "account": {
        "username": "buyer@lumenlabs.example",
        "password_env": "NORTHWIND_BUYER_PASSWORD"
      },
      "order_request": [
        { "method": "POST", "path_regex": "^/api/checkout/place-order$" }
      ],
      "js_readable_cookies": [],
      "asset_hosts": []
    },
    {
      "id": "acme",
      "name": "Acme Office & Tech",
      "platform": "woocommerce",
      "base_url": "https://acme.{BASE_DOMAIN}",
      "login_url": "https://acme.{BASE_DOMAIN}/my-account/",
      "account": {
        "username": "lumenlabs-buyer",
        "password_env": "ACME_BUYER_PASSWORD"
      },
      "order_request": [
        { "method": "POST", "path_regex": "^/\\?wc-ajax=checkout(&.*)?$" },
        { "method": "POST", "path_regex": "^/checkout/?(\\?.*)?$" }
      ],
      "js_readable_cookies": ["woocommerce_items_in_cart", "woocommerce_cart_hash"],
      "asset_hosts": []
    }
  ]
}
