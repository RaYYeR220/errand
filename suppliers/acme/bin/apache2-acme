#!/bin/sh
# Syncs WordPress, WooCommerce, the theme and the must-use plugin from the image
# into the document root on every start (the stock image keeps /var/www/html in
# a volume, which would otherwise pin the first version ever started), then
# runs Apache.
set -eu

cd /var/www/html
for managed in wp-content/mu-plugins wp-content/plugins/woocommerce wp-content/themes/storefront; do
  rm -rf "$managed"
done
tar -C /usr/src/wordpress --exclude=./wp-content/uploads -cf - . | tar -xf -

exec apache2-foreground "$@"
