[Unit]
Description=Errand orchestrator (runs, sandboxes, ledger, MCP)
After=network-online.target
Wants=network-online.target

[Service]
User=errand
Group=errand
SupplementaryGroups=kvm
WorkingDirectory=/opt/errand/services/orchestrator
EnvironmentFile=/etc/errand/errand.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/errand /home/errand

[Install]
WantedBy=multi-user.target
